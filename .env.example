# Необязательный файл: cp .env.example .env. Без него docker compose up тоже запускается.

# Ключ OpenAI — необязательно. Без ключа агент работает в детерминированном режиме:
# тот же порядок шагов и те же числа прогноза (их считает модель, не LLM), анализ — по шаблону.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Как часто агент сам проверяет погоду в Live и решает, выпускать ли новую версию (минуты).
# 0 — выключено. Каждый запуск Live (свой и по кнопке) пишется в outputs/live/journal.jsonl.
LIVE_WATCH_MINUTES=30
